import com.sun.jini.start.NonActivatableServiceDescriptor;
import com.sun.jini.start.ServiceDescriptor;

com.sun.jini.start {
    private static cp = System.getProperty("java.class.path");
    private static policy = System.getProperty("java.security.policy");
    private static lookupConfig = System.getProperty("cluster.lookupConfig");
    private static codebaseDir = System.getProperty("cluster.codebaseDir");

    serviceDescriptors = new ServiceDescriptor[] {
        new NonActivatableServiceDescriptor("", policy, cp,
            "com.sun.jini.tool.ClassServer", new String[] {
                "-port", "23333", "-dir", codebaseDir
            }),
        new NonActivatableServiceDescriptor(
            "http://127.0.0.1:23333/reggie-dl-2.2.1.jar", policy, cp,
            "com.sun.jini.reggie.TransientRegistrarImpl",
            new String[] { lookupConfig })
    };
}
